# Copy to .env (or set these in your host) before going live.

# --- Panel access (REQUIRED in production) -------------------------------------------------
# Without it, anyone who reaches the URL can read and control everything.
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# --- AI engine -----------------------------------------------------------------------------
# Default engine: OpenAI. Order when several keys exist: OpenAI -> NVIDIA -> Anthropic (each is the fallback of the previous one).
OPENAI_API_KEY=sk-...
# Optional: comma-separated model order (default gpt-6-luna,gpt-5.6-luna,gpt-5.4-nano) and reasoning effort for the reply writer (default low)
# OPENAI_MODEL=
# OPENAI_REASONING=low
# Force a single engine: AI_PROVIDER=openai | nvidia | anthropic | local
# Reply timing: HUMAN_PACE=off (instant, for demos/tests) | fast | (unset = human reading and typing pauses)
# NVIDIA NIM (https://build.nvidia.com). Also accepted: NVIDIA_NIM_API_KEY, NVIDIA, Nvidia.
NVIDIA_API_KEY=nvapi-...
# Optional: comma-separated model order. Defaults tuned from real tests:
# nvidia/nemotron-3.5-lightning-30b-a3b,openai/gpt-oss-20b,nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_MODEL=
# Optional alternative provider: ANTHROPIC_API_KEY=...   (AI_PROVIDER=nvidia|anthropic|local to force one)

# --- Channels (each is optional) -----------------------------------------------------------
# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Messenger / Instagram page tokens
MESSENGER_PAGE_TOKEN=
INSTAGRAM_PAGE_TOKEN=
# Meta webhook: the verify token you type in Meta for Developers, and your app secret (rejects forged webhooks)
META_VERIFY_TOKEN=
META_APP_SECRET=

# --- Embudo Contadores D1/D2/D3 -------------------------------------------------------------
# Links sent in the automatic reply. If one is empty, the lead is handed to a human instead of receiving a placeholder.
CONTADORES_LINK_D1=
CONTADORES_LINK_D2=
CONTADORES_LINK_D3=

# --- Server --------------------------------------------------------------------------------
PORT=3000
DB_PATH=data/omni.db
